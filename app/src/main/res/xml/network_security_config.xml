<?xml version="1.0" encoding="utf-8"?>
<!--
  网络安全配置：
  - 禁止明文 HTTP（全 app 强制 HTTPS）
  - 不信任用户安装的 CA（防抓包工具中间人；书城另有证书绑定，双重防护）
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
